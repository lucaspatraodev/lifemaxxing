# Copie para .env.local para rodar com "vercel dev". Na Vercel, cadastre em
# Project Settings › Environment Variables. Nunca faça commit das chaves.

# Senha (OPCIONAL). Deixe vazio para o app abrir direto, sem login.
APP_PASSWORD=
SESSION_SECRET=

# Supabase (Project Settings › API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# IA do coach: preencha pelo menos uma chave
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Extras (mesmo formato da OpenAI)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Qual usar por padrão: gemini | groq | openai | deepseek | openrouter
IA_PROVEDOR=gemini
